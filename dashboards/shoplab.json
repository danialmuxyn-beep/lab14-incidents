{
  "uid": "shoplab-red",
  "title": "ShopLab — RED",
  "tags": ["lab14"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {"id": 1, "type": "timeseries", "title": "Rate by service / route",
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
     "targets": [{"refId": "A", "expr": "sum by (job, route) (rate(http_requests_total[1m]))", "legendFormat": "{{job}} {{route}}"}],
     "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []}},
    {"id": 2, "type": "timeseries", "title": "5xx ratio by service",
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
     "targets": [{"refId": "A", "expr": "(sum by (job) (rate(http_requests_total{status=~\"5..\"}[5m])) or (0 * sum by (job) (rate(http_requests_total[5m])))) / sum by (job) (rate(http_requests_total[5m]))", "legendFormat": "{{job}}"}],
     "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0}, "overrides": []}},
    {"id": 3, "type": "timeseries", "title": "p95 latency by route",
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
     "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (route, le) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{route}}"}],
     "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []}},
    {"id": 4, "type": "timeseries", "title": "Checkout error budget: burn rate (lines at 6x and 14.4x)",
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
     "targets": [
       {"refId": "A", "expr": "checkout:burn_rate:rate1h", "legendFormat": "1h window"},
       {"refId": "B", "expr": "checkout:burn_rate:rate5m", "legendFormat": "5m window"}],
     "fieldConfig": {"defaults": {"unit": "suffix:x", "min": 0,
       "custom": {"thresholdsStyle": {"mode": "line"}},
       "thresholds": {"mode": "absolute", "steps": [
         {"color": "green", "value": null},
         {"color": "orange", "value": 6},
         {"color": "red", "value": 14.4}]}}, "overrides": []}},
    {"id": 5, "type": "logs", "title": "Errors in logs (shop + payments)",
     "datasource": {"type": "loki", "uid": "loki"},
     "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
     "targets": [{"refId": "A", "expr": "{service=~\"shop|payments\"} | json | level=\"ERROR\"", "queryType": "range"}],
     "options": {"showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true}}
  ]
}
